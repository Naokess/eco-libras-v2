# ============================================================
# .env.example — ECO-Libras
# Copie para .env e ajuste os valores reais:
#   cp .env.example .env
# O .env NÃO vai pro git (está no .gitignore da raiz).
# ============================================================

# --- Postgres (usado pelo docker-compose e pelo Prisma) ---
POSTGRES_USER=eco_libras
POSTGRES_PASSWORD=eco_libras_dev
POSTGRES_DB=eco_libras

# --- URL de conexão do Prisma (API) ---
# Dentro do compose, o host é "postgres" (nome do serviço).
# Rode: cd apps/api && npx prisma migrate dev
DATABASE_URL=postgresql://eco_libras:eco_libras_dev@localhost:5432/eco_libras

# --- API ---
PORT=3000

# --- Web / Frontend ---
# URL-base que o front usa para chamar a API
NEXT_PUBLIC_API_URL=http://localhost:3001
