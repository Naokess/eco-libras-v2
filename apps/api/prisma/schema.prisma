generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String   @unique
  description String?
  coverUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  terms       Term[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  order     Int      @default(0)
  terms     Term[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  terms TermTag[]
}

model Term {
  id         Int      @id @default(autoincrement())
  term       String
  slug       String   @unique
  definition String
  example    String?
  videoUrl   String?
  videoMeta  Json?
  coverUrl   String?
  status     Status   @default(PUBLISHED)
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])
  courseId   Int?
  course     Course?   @relation(fields: [courseId], references: [id])
  tags       TermTag[]
  specialist String?
  authorId   Int?
  author     User?     @relation(fields: [authorId], references: [id])
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([courseId])
  @@index([categoryId])
  @@index([status])
}

model TermTag {
  termId Int
  tagId  Int
  term   Term @relation(fields: [termId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([termId, tagId])
}

model ContactMessage {
  id        Int       @id @default(autoincrement())
  name      String
  email     String
  message   String
  status    MsgStatus @default(NEW)
  createdAt DateTime  @default(now())
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String
  name         String
  role         Role           @default(EDITOR)
  isActive     Boolean        @default(true)
  terms        Term[]
  RefreshToken RefreshToken[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Role   { 
  ADMIN 
  EDITOR 
}
enum MsgStatus { 
  NEW 
  READ 
  REPLIED 
}




